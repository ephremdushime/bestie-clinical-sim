# Development by default. Shared tokens are accepted only outside production.
# In production, protected routes require provisioned account bearer sessions.
APP_ENV=development
PILOT_ACCESS_TOKEN=replace_with_a_long_random_student_pilot_token
EDUCATOR_ACCESS_TOKEN=replace_with_a_different_long_random_educator_token

# Optional OpenAI-compatible chat-completions endpoint; API key stays on backend only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_with_your_secret_key
LLM_MODEL=replace_with_a_model_name

# Exact frontend origins, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional persistent database path; Docker Compose sets this to /data/clinical_sim.db
# CLINICAL_SIM_DB=/data/clinical_sim.db
